<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The FUSE library is the user's installed macFUSE / FUSE-T, signed by another team:
         library validation would refuse to load it into our hardened process. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- ctypes/libffi callbacks (every FUSE operation is a callback into Python) need
         writable+executable memory under the hardened runtime. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
